# .gitignore - TeknoFixHub

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# Database
*.db
*.sqlite
*.sqlite3

# Uploads
media/*
!media/.gitkeep
storage/*
!storage/.gitkeep

# OS
.DS_Store
Thumbs.db

# Cache
.cache/
.eslintcache
.next/
.nuxt/

# Database backups
backups/*
!backups/.gitkeep

# Temporary files
tmp/
temp/
*.tmp

# Docker
docker-compose.override.yml
.docker/

# IDE Extensions
.vscode/extensions/
.vscode/launch.json

# Application specific
.env.*.local
config.local.js
config.local.json
