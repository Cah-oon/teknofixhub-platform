# TeknoFixHub Production Environment Template
# Copy to backend/.env dan isi dengan nilai production

# ===== SERVER CONFIGURATION =====
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# ===== DATABASE CONFIGURATION =====
# MongoDB Atlas
MONGO_URI=mongodb+srv://teknofixhub:PASSWORD@cluster0.xxxxx.mongodb.net/teknofixhub?retryWrites=true&w=majority
DB_NAME=teknofixhub

# Atau PostgreSQL
# POSTGRES_URI=postgresql://user:password@host:port/teknofixhub

# ===== SECURITY =====
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ===== CORS CONFIGURATION =====
CORS_ORIGIN=https://yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# ===== FILE UPLOAD =====
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/media

# ===== API CONFIGURATION =====
API_VERSION=v1
API_URL=https://api.yourdomain.com

# ===== EMAIL SERVICE =====
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@yourdomain.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ===== CLOUD STORAGE (AWS S3) =====
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=teknofixhub
AWS_REGION=us-east-1

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FILE=/app/logs/application.log

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== OPTIONAL: PAYMENT GATEWAY =====
STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx

# ===== OPTIONAL: THIRD PARTY SERVICES =====
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
