# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/teknofixhub
DB_NAME=teknofixhub

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRE=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=../media

# API
API_VERSION=v1
API_URL=http://localhost:5000

# CORS
CORS_ORIGIN=http://localhost:3000
